{"phlasma_vfx":1,"note":"smoke test: every op once","res":[480,270],"fps":30,"duration":2,
 "nodes":{
  "w":{"op":"wobble"},"l":{"op":"lfo","params":{"freq":1}},"v":{"op":"value","params":{"v":"l.v * 0.5 + 0.5"}},
  "c":{"op":"constant","params":{"color":"#1D847E"}},
  "r":{"op":"ramp","params":{"kind":"radial","a":"#ffffff","b":"#000000"}},
  "n":{"op":"noise","params":{"color":true}},
  "s":{"op":"shape","params":{"kind":"box","size":[0.2,0.1],"rotate":"t*40","color":[1,0.3,0.2,1]}},
  "s2":{"op":"shape","params":{"kind":"line","size":[0.3,0],"width":0.01}},
  "tr":{"op":"transform","inputs":["n"],"params":{"rotate":"v.v*30","extend":"mirror"}},
  "lv":{"op":"level","inputs":["tr"],"params":{"contrast":1.4,"limit":true}},
  "h":{"op":"hsv","inputs":["lv"],"params":{"hue":"t*0.2"}},
  "b":{"op":"blur","inputs":["h"],"params":{"size":6}},
  "cp":{"op":"composite","inputs":["s","b"]},
  "cp2":{"op":"composite","inputs":["s2","cp"],"params":{"mode":"add"}},
  "d":{"op":"displace","inputs":["cp2","n"],"params":{"amount":0.05}},
  "ed":{"op":"edge","inputs":["d"]},
  "th":{"op":"threshold","inputs":["r"]},
  "cm":{"op":"colormap","inputs":["r"]},
  "k":{"op":"kaleido","inputs":["d"]},
  "px":{"op":"pixelate","inputs":["k"],"params":{"cells":40}},
  "ch":{"op":"chroma","inputs":["px"]},
  "sh":{"op":"wgsl","inputs":["ch","ed"],"params":{"inputs":2,"a":0.5,"code":"return mix(input0(uv), input1(uv), a);"}},
  "im":{"op":"image","params":{"file":"still.png","fit":"fit"}},
  "mv":{"op":"movie","params":{"file":"clip.mp4"}},
  "tx":{"op":"text","params":{"text":"lfo {l.v:+.2f}","font":"mono","color":"#ffffff","pos":[0.04,0.92]}},
  "fb":{"op":"feedback","params":{"source":"out"},"inputs":["c"]},
  "m1":{"op":"composite","inputs":["mv","im"],"params":{"mode":"over","mix":0.5}},
  "m2":{"op":"composite","inputs":["sh","m1"],"params":{"mode":"screen"}},
  "m3":{"op":"composite","inputs":["tx","m2"]},
  "m4":{"op":"composite","inputs":["cm","th"],"params":{"mode":"multiply"}},
  "m5":{"op":"composite","inputs":["m4","m3"],"params":{"mode":"mix","mix":0.2}},
  "out":{"op":"composite","inputs":["m5","fb"],"params":{"mode":"max","mix":"0.9"}}
 },"output":"out"}
